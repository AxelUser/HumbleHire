	},
	"dependencies": {
		"@humblehire/test-bridge": "workspace:*",
		"ffmpeg-static": "^5.3.0",
		"playwright": "^1.58.2"
	},
	"devDependencies": {
		"tsx": "^4.20.6",
		"typescript": "^5.0.0"
	}
}
