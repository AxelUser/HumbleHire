{
	"name": "humblehire",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"gen:pwa-assets": "pwa-assets-generator",
		"gen:docs-assets": "pnpm --filter @humblehire/docs-assets generate",
		"gen:schema": "node scripts/gen-schema.mjs"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@humblehire/dev-bridge": "workspace:*",
		"@internationalized/date": "^3.12.0",
		"@jsonresume/schema": "^1.2.1",
		"@lucide/svelte": "^1.17.0",
		"@playwright/test": "^1.49.1",
		"@storybook/addon-a11y": "^10.3.0",
		"@storybook/addon-docs": "^10.3.0",
		"@storybook/addon-svelte-csf": "^5.0.12",
		"@storybook/addon-vitest": "^10.3.0",
		"@storybook/sveltekit": "^10.3.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@types/node": "^24",
		"@types/pdfmake": "^0.3.3",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitest/browser": "^3.2.6",
		"@vitest/coverage-v8": "^3.2.6",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-storybook": "^10.3.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jsdom": "^26.0.0",
		"json-schema-to-typescript": "^15.0.4",
		"lint-staged": "^17.0.7",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.58.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.7.0",
		"storybook": "^10.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^6.0.0",
		"vitest": "^3.2.6",
		"xxhash-wasm": "^1.1.0"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,html,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"ffmpeg-static"
		]
	},
	"dependencies": {
		"@dnd-kit/helpers": "^0.3.2",
		"@dnd-kit/svelte": "^0.3.2",
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"dexie": "^4.3.0",
		"fuse.js": "^7.3.0",
		"nanoid": "^5.1.11",
		"pdfjs-dist": "^5.7.284",
		"pdfmake": "^0.3.8",
		"posthog-js": "^1.376.5",
		"runed": "^0.37.1"
	}
}
